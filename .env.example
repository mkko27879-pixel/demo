# 把本文件复制为 .env，再填入自己的密钥
# 获取方式：
#   DASHSCOPE_API_KEY -> 阿里云百炼控制台 https://bailian.console.aliyun.com/
#   DEEPSEEK_API_KEY  -> DeepSeek 开放平台 https://platform.deepseek.com/

DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 向量化模型（不填则用 text-embedding-v4）
# 注意：换模型后向量维度会变，必须同步改 vector_store.py 里的 EMBED_DIM 并重建 collection
EMBEDDING_MODEL=text-embedding-v4

# 检索最低相似度（不填则用 0.28），低于它的片段会被丢掉
MIN_SCORE=0.28

# 论文元数据库位置（不填则用 data/papers.db）
PAPER_DB_PATH=data/papers.db
# 上传大小上限，单位字节（不填则用 50MB）
MAX_UPLOAD_BYTES=52428800

# 大模型接口地址（按需修改）
OPENAI_BASE_URL=

# 问答用的 DeepSeek 兼容接口（不填则用 https://api.deepseek.com）
# 换成中转/代理时改这里
DEEPSEEK_BASE_URL=
# 可用模型：deepseek-flash、deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
